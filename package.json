{
  "name": "structly",
  "version": "1.0.0",
  "description": "- Complexitati\r   - Methods\r   - Most Frequently asked interview questions about this data structure\r   - Algorithms that use this data structure\r   - LeetCode guide for understanding this data structure better and its use.",
  "main": "index.js",
  "scripts": {
    "dev": "node server.js",
    "build": "next build",
    "start": "NODE_ENV=production node server.js",
    "lint": "next lint",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "clean": "rd /s /q .next && rd /s /q node_modules\\.cache"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverage": true,
    "collectCoverageFrom": [
      "lib/**/*.js",
      "components/**/*.js"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/.next/",
      ".*\\.d\\.ts$",
      ".*\\.jsx$",
      ".*\\.tsx?$",
      "components/usageChart.js"
    ],
    "moduleNameMapper": {
      "^react-icons/fi$": "<rootDir>/__mocks__/react-icons-fi.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Andreea410/Structly.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Andreea410/Structly/issues"
  },
  "homepage": "https://github.com/Andreea410/Structly#readme",
  "dependencies": {
    "@faker-js/faker": "^9.7.0",
    "chart.js": "^4.4.8",
    "daisyui": "^5.0.6",
    "dotenv": "^16.5.0",
    "formidable": "^3.5.2",
    "framer-motion": "^12.6.2",
    "mongoose": "^8.14.0",
    "next": "^15.3.0",
    "next-pwa": "^5.6.0",
    "react": "^19.1.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.1.0",
    "react-icons": "^5.5.0",
    "recharts": "^2.15.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@babel/preset-env": "^7.26.9",
    "@babel/preset-react": "^7.26.3",
    "@tailwindcss/postcss": "^4.0.17",
    "@tailwindcss/postcss7-compat": "^2.2.17",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.14",
    "autoprefixer": "^10.4.21",
    "babel-jest": "^29.7.0",
    "concurrently": "^9.1.2",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.3",
    "postcss-import": "^16.1.0",
